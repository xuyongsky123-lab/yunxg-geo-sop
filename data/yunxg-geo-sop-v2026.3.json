  "kpis": [
    {
      "id": "KPI01",
      "name": "AI 引用频次",
      "nameEn": "AI Citation Count",
      "definition": "标准问题集中 AI 引用品牌的绝对次数",
      "frequency": "每周",
      "target": "环比持续增长"
    },
    {
      "id": "KPI02",
      "name": "AI 可见度率",
      "nameEn": "AI Visibility Rate",
      "definition": "含品牌的回答数 ÷ 总测试问题数 × 100%；须按六维与分模型分列",
      "frequency": "每周",
      "target": "≥30%（作业参考，非承诺）"
    },
    {
      "id": "KPI03",
      "name": "首位率",
      "nameEn": "First Position Rate (FPR)",
      "definition": "本品牌首位推荐次数 ÷ 品牌已被提及的回答数 × 100%",
      "frequency": "每周",
      "target": "复测高于 Phase 0 基线"
    },
    {
      "id": "KPI04",
      "name": "回答准确率",
      "nameEn": "Answer Accuracy",
      "definition": "描述准确的问题数 ÷ 总测试数 × 100%",
      "frequency": "每月",
      "target": "≥95%（作业参考，非承诺）"
    },
    {
      "id": "KPI05",
      "name": "AI 声音份额",
      "nameEn": "Share of Voice",
      "definition": "本品牌引用次数 ÷ 全部竞品引用总次数",
      "frequency": "每月",
      "target": "行业前 3（相对观察）"
    },
    {
      "id": "KPI06",
      "name": "品牌提及率",
      "nameEn": "Brand Mention Rate",
      "definition": "全网新增品牌名提及量（含无链接）",
      "frequency": "每月",
      "target": "环比 ≥10%（作业参考，非承诺）"
    },
    {
      "id": "KPI07",
      "name": "情感倾向",
      "nameEn": "Sentiment Score",
      "definition": "AI 引用中正面描述占比；须附正/中/负原话",
      "frequency": "每月",
      "target": "正面 ≥85%（作业参考，非承诺）"
    },
    {
      "id": "KPI08",
      "name": "信源引用链接数",
      "nameEn": "Citation Link Count",
      "definition": "回答中附带本品牌域名 URL 的次数",
      "frequency": "每月",
      "target": "持续增长"
    },
    {
      "id": "KPI09",
      "name": "AI 引荐流量",
      "nameEn": "AI Referral Traffic",
      "definition": "统计工具中来源为 AI 平台的访问量",
      "frequency": "每月",
      "target": "同比增长（可观察，非承诺）"
    },
    {
      "id": "KPI10",
      "name": "引用持久率",
      "nameEn": "Citation Persistence",
      "definition": "同一信源连续 3 个月仍被引用的比例",
      "frequency": "季度",
      "target": "核心源 ≥70%（作业参考，非承诺）"
    },
    {
      "id": "KPI11",
      "name": "品牌词搜索提升",
      "nameEn": "Branded Search Lift",
      "definition": "指数类工具中品牌词搜索量变化",
      "frequency": "每月",
      "target": "同比增长（可观察，非承诺）"
    },
    {
      "id": "KPI12",
      "name": "AI 转化率",
      "nameEn": "AI-Assisted Conversion",
      "definition": "AI 引荐流量的实际转化率（询盘 / 预约 / 成交）",
      "frequency": "季度",
      "target": "建立基准后逐期对比"
    }
  ],
